{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "$schema": {
      "description": "Editor-only JSON Schema URL. Ignored by ForgeRelay resolution.",
      "type": "string"
    },
    "systemInstructionsPath": {
      "description": "Selected system-level Agent instruction file consumed by ForgeRelay.",
      "type": "string",
      "minLength": 1,
      "default": "~/.agents/AGENTS.md",
      "x-forgerelay-scopes": [
        "runtime",
        "project-local",
        "project",
        "user",
        "built-in"
      ],
      "x-forgerelay-merge": "replace",
      "x-forgerelay-reload": "hot",
      "x-forgerelay-sensitivity": "public",
      "x-forgerelay-interpolation": "none",
      "x-forgerelay-execution-effect": "none",
      "x-forgerelay-runtime-override": {
        "env": "FORGERELAY_SYSTEM_INSTRUCTIONS_PATH"
      }
    },
    "instructionNames": {
      "description": "Project instruction basenames discovered hierarchically within a Workspace.",
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "default": [
        "AGENTS.md"
      ],
      "x-forgerelay-scopes": [
        "runtime",
        "project-local",
        "project",
        "user",
        "built-in"
      ],
      "x-forgerelay-merge": "replace",
      "x-forgerelay-reload": "hot",
      "x-forgerelay-sensitivity": "public",
      "x-forgerelay-interpolation": "none",
      "x-forgerelay-execution-effect": "none",
      "x-forgerelay-runtime-override": {
        "env": "FORGERELAY_INSTRUCTION_NAMES"
      }
    },
    "skillPaths": {
      "description": "Ordered Agent Skill source directories; explicit higher-precedence lists replace lower-precedence lists.",
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "default": [
        "~/.agents/skills",
        "./.agents/skills"
      ],
      "x-forgerelay-scopes": [
        "runtime",
        "project-local",
        "project",
        "user",
        "built-in"
      ],
      "x-forgerelay-merge": "replace",
      "x-forgerelay-reload": "hot",
      "x-forgerelay-sensitivity": "public",
      "x-forgerelay-interpolation": "none",
      "x-forgerelay-execution-effect": "none",
      "x-forgerelay-runtime-override": {
        "env": "FORGERELAY_SKILL_PATHS"
      }
    }
  },
  "additionalProperties": false,
  "$id": "https://raw.githubusercontent.com/Akira-TL/forgerelay/main/schemas/v1/config.project-local.schema.json",
  "title": "ForgeRelay general configuration (project-local)",
  "description": "Canonical ForgeRelay general configuration. Domain-specific MCP, Language Server, Hook, Subagent, and credential settings use separate sources."
}
