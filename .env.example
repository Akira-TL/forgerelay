HOST=127.0.0.1
PORT=7676

# Owner password generated by `forgerelay init` in ~/.forgerelay/auth.json.
# Set this only for non-interactive or fully env-driven deployments.
# FORGERELAY_OAUTH_OWNER_TOKEN=change-me-to-a-long-random-secret
# Optional OAuth tuning.
# FORGERELAY_OAUTH_ACCESS_TOKEN_TTL_SECONDS=3600
# FORGERELAY_OAUTH_REFRESH_TOKEN_TTL_SECONDS=2592000
# FORGERELAY_OAUTH_SCOPES=forgerelay
# FORGERELAY_OAUTH_ALLOWED_REDIRECT_HOSTS=chatgpt.com,localhost,127.0.0.1

FORGERELAY_ALLOWED_ROOTS=/home/user/projects
# For temporary tunnels, prefer setting this per run. ForgeRelay derives the
# inbound Host allowlist from this URL.
# FORGERELAY_PUBLIC_BASE_URL=https://your-public-host.example.com
# Advanced escape hatch. `*` disables Host header allowlist protection.
# FORGERELAY_ALLOWED_HOSTS=localhost,127.0.0.1,your-public-host.example.com

# minimal | full | codex. minimal is the default; minimal and full expose the
# canonical ForgeRelay tool surface, while codex exposes the compatibility adapter.
FORGERELAY_TOOL_MODE=minimal
# off | changes | full. Defaults to full.
FORGERELAY_WIDGETS=changes
# FORGERELAY_ACTIVITY_PANEL_EXPANDED=1

FORGERELAY_LOG_LEVEL=info
FORGERELAY_LOG_FORMAT=json
FORGERELAY_LOG_REQUESTS=1
FORGERELAY_LOG_ASSETS=0
FORGERELAY_LOG_TOOL_CALLS=1
FORGERELAY_LOG_SHELL_COMMANDS=0
# FORGERELAY_TRUST_PROXY=1

# FORGERELAY_STATE_DIR=/home/user/.local/share/forgerelay
# FORGERELAY_WORKTREE_ROOT=/home/user/.forgerelay/worktrees

# Native-file download is opt-in. Files stream to a model-selected relative
# path inside an already-open workspace without overwriting existing files.
# FORGERELAY_ARTIFACTS=1
# FORGERELAY_ARTIFACT_MAX_FILE_BYTES=104857600

# Skills are enabled by default. Set FORGERELAY_SKILLS=0 to hide them.
# FORGERELAY_SKILLS=0
# FORGERELAY_AGENT_DIR=/home/user/.codex
# FORGERELAY_SKILL_PATHS=/home/user/.codex/skills,/home/user/.claude/skills

# Subagent providers are external CLI integrations. ForgeRelay does not install
# or bundle Codex, Claude Code, OpenCode, Pi, Cursor, or Copilot runtimes.
# FORGERELAY_SUBAGENTS=1
# CODEX_COMMAND=/path/to/codex
# CLAUDE_COMMAND=/path/to/claude
# OPENCODE_COMMAND=/path/to/opencode
# PI_COMMAND=/path/to/pi
